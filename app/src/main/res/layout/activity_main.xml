<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gyro Mapper"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 Service Stopped"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/startStopButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Service"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/accessibilityButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="⚠️ Enable Accessibility Service"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/foregroundText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foreground: None"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/gyroStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IMU: Unknown"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/calibrationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calibration: Idle"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hold the device still for 2 seconds to auto-calibrate"
        android:textSize="14sp"
        android:textColor="#888888"
        android:gravity="center" />

</LinearLayout>